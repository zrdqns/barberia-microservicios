# Copie este archivo como .env (en esta misma carpeta) y llénelo con los datos de su proyecto de
# Supabase: botón "Connect" del proyecto, pestaña "Direct", método "Session pooler".
# Los dos microservicios leen este archivo al arrancar. El .env no se sube a GitHub.

# Host y puerto del Session pooler (puerto 5432), con sslmode=require
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Usuario del pooler: postgres.<referencia del proyecto>
DB_USER=postgres.abcdefghijklmnopqrst
# Contraseña de la base de datos, la que se escogió al crear el proyecto
DB_PASSWORD=
