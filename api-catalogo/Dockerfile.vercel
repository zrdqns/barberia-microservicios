# Imagen con la que Vercel corre este microservicio como función (Container Runtime).
# Primero se compila el .jar con Maven y después se corre solo con el JRE.
FROM maven:3.9-eclipse-temurin-17 AS compilacion
WORKDIR /app
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src src
RUN mvn -q -B package -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=compilacion /app/target/*.jar app.jar
# Vercel envía el tráfico al puerto de PORT (80 si no se define). TieredStopAtLevel=1 acorta el
# arranque, que se repite cada vez que la función vuelve después de cinco minutos sin uso.
CMD ["sh", "-c", "exec java -XX:TieredStopAtLevel=1 -jar app.jar --server.port=${PORT:-80}"]
